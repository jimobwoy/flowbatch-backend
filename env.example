# ---- REQUIRED in production --------------------------------------------
NODE_ENV=production
# 48+ random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# You sign in to https://YOUR-DOMAIN/admin with these.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=
# Public https address of this server (no trailing slash).
PUBLIC_URL=https://api.yourdomain.com

# ---- Paystack (billing) ------------------------------------------------
# Use an sk_test_... key while testing, sk_live_... when you go live.
PAYSTACK_SECRET_KEY=

# ---- Optional ----------------------------------------------------------
PORT=8787
# Put this on a PERSISTENT disk/volume or you will lose your users on redeploy.
DATABASE_PATH=./data/app.db
CURRENCY=NGN
TRIAL_DAYS=3
# Dashboard day boundaries. 60 = Africa/Lagos (UTC+1).
TZ_OFFSET_MINUTES=60
# Set to 1 when running behind a proxy/load balancer (Railway, Render, nginx)
# so per-IP rate limits see the real client IP.
TRUST_PROXY=1
# Prices are in MINOR units (kobo): 500000 = ₦5,000. These are placeholders!
# PLANS_JSON=[{"id":"monthly","name":"Monthly","days":30,"amount":500000},{"id":"quarterly","name":"3 months","days":90,"amount":1350000},{"id":"yearly","name":"Yearly","days":365,"amount":4800000}]
